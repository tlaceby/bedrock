mod main;
use std::fmt;

fn main () {
  const BUFFER_SIZE = 1024;
  let x = 10;
  x = x + 1; // no ++ or -- pre/post incriment/decrement in the language

  let x_ptr: *number = &x; // Just like in C, you can create a pointer/reference like this. There is no pointer arithemitic in bedrock. 
  // Pointers are useful for passing by reference into functions when you need to mutate a value and dont want to create a copy.
  x_ptr* = 0;

  fmt.printf("x : %v\n", x); // 0
  fmt.printf("x_ptr* : %v\n", x_ptr*); // 0

  // Options and Unknown Values
  let optional_num: Option<number> = 20; // This means a number may or may not exist in this type.
  let another_optional_num: Option<number>; // this variable has no value unlike the one above.
}
use std.io; // loads the std.io module
use std.fs; // loads the std.fs module
use test.a; // ./examples/a.br
use foo; // loads the foo.br file in ./foo.br


// Bedrock uses structural typing over `nominal typing`, so if a type walks like a duck and quacks like a duck,
// it's a bloody duck according to the compiler. No need to use `implements` or `extends`.
trait ICommunicate {
  fn communicate();
}

pub struct Person {
  name: str;
  age: isize;
}

impl Person {
  // static constructor
  pub fn new(name: str, age: isize) -> Self {
    return Self{ name, age };
  }

  // satisfies ICommunicate interface structurally
  pub fn communicate(self) {
    io.printf("Hello from %s\n:", self.name);
  }

  pub fn birthday(ref self) {
    self.age += 1;
  }
}

pub struct Cat {
  name: str;
  age: isize;
}

impl Cat {
  pub fn new(name: str, age: isize) -> Self {
    return Self{ name, age };
  }

  pub fn communicate(self) {
    io.printf("%s says meow!\n:", self.name);
  }
}

// Example Option type (defined in std.option)
enum Option<T> {
  None,
  Some(T),
}

impl Option<T> {
  pub fn is_some(self) -> bool {
    match self {
      Some(_) => true,
      None => false,
    }
  }

  pub fn unwrap(self) -> T {
    match self {
      Some(value) => value,
      None => panic("Called unwrap on None"),
    }
  }
}

// C-Interop with FFI
// tell the bedrock compiler where to look for your library, and then load it.

extern "./library/mylib.so" {
  struct c_person {
    name: *char,
    age: i32,
  } as CPerson;

  fn add(x: f64, y: f64) -> f64;
}

struct FILE; // creating a opaque type
extern fn fopen(path: *char, mode: *char) -> *FILE;

fn main(args: []str) {
  c1 := Cat::new("Whiskers", 7);
  c2 := Cat::new("Timmy", 10);
  c3 := Cat::new("Tom", 16);
  p1 := Person::new("Sam", 32);
  p2 := Person::new("Jenna", 43);

  speakables := []ICommunicate{};

  // Loop over BOTH cat and person arrays at same time. Will continue with the largest array bounds.
  for (cat, person) in ([]Cat{c1, c2, c3}, []Person{p1, p2}) {
    if cat.is_some() {
      speakables = append(speakables, cat);
    }

    if person.is_some() {
      speakables = append(speakables, person);
    }
  }

  for entry in speakables {
    entry.communicate();
  }
}
